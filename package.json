{
  "name": "cashtracker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @cashtracker/api dev",
    "dev:web": "pnpm --filter @cashtracker/web dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "knip": "turbo run knip",
    "check": "turbo run typecheck lint format:check test knip",
    "test:e2e:api": "pnpm --filter @cashtracker/api test:e2e",
    "test:e2e:web": "pnpm --filter @cashtracker/web test:e2e",
    "test:e2e:web:signed-in": "pnpm --filter @cashtracker/web test:e2e:signed-in",
    "migration": "pnpm --filter @cashtracker/api migration",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
