{
  "name": "@cashtracker/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.mts",
    "typeorm": "ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration": "ts-node scripts/migration-master.ts",
    "restore": "bash scripts/restore-db.sh"
  },
  "dependencies": {
    "@cashtracker/shared": "workspace:*",
    "@clerk/backend": "^3.29.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
}
